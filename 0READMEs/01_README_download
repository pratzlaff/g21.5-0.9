#! /bin/bash

set -eo pipefail
SCRIPTDIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
basedir="$SCRIPTDIR"/..

. ~/.bash_aliases
shopt -s expand_aliases

ciao

#
# download data
#
. "$basedir"/src/functions.bash

mkdir -p data
cd data
for o in $(obsids)
do
  files=evt1,bpix,pbk,msk,flt,asol,bias,stat,mtl
  instrument $o | grep -qi hrc && files=evt1,bpix,msk,flt,asol,dtf,mtl
  download_chandra_obsid $o $files
done
cd -

