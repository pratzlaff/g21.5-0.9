#! /bin/bash

set -eo pipefail
SCRIPTDIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
basedir="$SCRIPTDIR"/..
regdir="$basedir"/region

. ~/.bash_aliases
shopt -s expand_aliases

ciao -o

. "$basedir"/src/functions.bash

mkdir -p "$basedir"/images/hrc{s,i}/vlk

for o in $(obsids)
do
    inst=$(instrument $o)

    echo $inst | \grep -qi hrc || continue

    for s in vlk me
    do
        srcreg="$regdir"/halo.reg

        # 5168 has a special source region
        [ -f "$regdir/${o}_halo.reg" ] && srcreg="$regdir/${o}_halo.reg"

        echo $inst | grep -qi hrc-i && {
            outdir="$basedir"/images/hrci
            bgreg="$regdir"/bg_i.reg
        }

        echo $inst | grep -qi hrc-s && {
            outdir="$basedir"/images/hrcs
            bgreg="$regdir/${o}_bg.reg"
        }

        [ $s == vlk ] && {
            outdir="$outdir/vlk"
            srcreg=$(printf "$regdir"/vlk/src_r43_%05d.reg $o)
            bgreg="$regdir"/vlk/g21.5_a180t250.reg
            echo $inst | grep -qi hrc-s && \
                bgreg=$(printf "$regdir"/vlk/g21.5_%05d_bkg.reg $o)
        }

        [ -f "$srcreg" -a -f "$bgreg" ] || continue

        ds9 \
          "$basedir"/data/$o/tg_reprocess/*evt2.fits \
          -bin factor 16 \
	  -scale mode 99.5 \
          -regions format ciao \
	  -regions "$srcreg" \
	  -regions $bgreg \
          -saveimage "$outdir/$o.jpg" \
	  -exit
    done

done
